# Copy to .env and fill in. Every variable marked REQUIRED is validated at boot
# by src/config/env.js - the server refuses to start if one is missing.

# REQUIRED - MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/genaiapp

# REQUIRED - secret used to sign ACCESS tokens.
# Must be at least 32 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional but recommended - a SECOND, different secret for REFRESH tokens.
# Using two secrets means a leaked access-token secret cannot mint refresh
# tokens. If left blank, one is derived from JWT_SECRET.
JWT_REFRESH_SECRET=

# Token lifetimes. Short access tokens limit the damage of a stolen token;
# the refresh token keeps the user signed in without a long lived credential
# being sent on every request.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Claims checked on every token, so a token minted by another service or
# another environment is rejected.
JWT_ISSUER=genaiapp
JWT_AUDIENCE=genaiapp-client

# bcrypt work factor. Higher is slower to crack AND slower to log in.
# 12 is a reasonable 2025 default; do not go below 10.
BCRYPT_ROUNDS=12

# Allowed browser origins for CORS. Comma separated for multiple
# (production domain + preview deployments).
FRONTEND_URL=http://localhost:5173

PORT=3000
NODE_ENV=development

# Not auth related, used by the AI service.
GEMINI_API_KEY=
